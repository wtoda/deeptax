# ============================================================================
#  Variáveis de ambiente da Deeptax
#  Copie este arquivo para `.env.local` (desenvolvimento) ou cadastre estas
#  variáveis no painel da Vercel (produção).
# ============================================================================

# ----------------------------------------------------------------------------
# Domínio canônico (canonical, sitemap, robots e Open Graph).
# Deve ser o endereço REAL onde o site está publicado. Se você apontar
# deeptax.com.br para a Vercel, defina esta variável com esse domínio.
# Sem ela, o padrão é https://deeptax.vercel.app
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://www.deeptax.com.br

# ----------------------------------------------------------------------------
# OBRIGATÓRIA NA VERCEL: destino dos leads.
# ----------------------------------------------------------------------------
# Na Vercel o sistema de arquivos da função é somente leitura e /tmp é descartado
# entre execuções — ou seja, NÃO existe persistência local possível.
# Sem esta variável o formulário responde 503 e o visitante é encaminhado para o
# WhatsApp com os dados já preenchidos (o lead não se perde, mas não é gravado).
#
# Aceita qualquer endpoint que receba POST com JSON:
#   Slack       -> https://hooks.slack.com/services/XXX/YYY/ZZZ
#   n8n / Make / Zapier -> URL do webhook
#   Google Apps Script  -> URL do app publicado
#   CRM próprio -> endpoint que aceite POST JSON
#
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ----------------------------------------------------------------------------
# OPICIONAL: em VPS ou container com disco persistente, os leads são gravados
# em `data/leads.jsonl` sem precisar de webhook.
# ----------------------------------------------------------------------------

# Nome exibido no payload enviado ao webhook (opcional)
# NEXT_PUBLIC_SITE_NAME=Deeptax

# ----------------------------------------------------------------------------
# OPICIONAL: ajuste da proteção anti-abuso do formulário.
# Padrão: 5 envios por IP a cada 10 minutos.
# Em serverless o contador é por instância; para proteção distribuída use o
# firewall da Vercel (ou Cloudflare) na frente do domínio.
# ----------------------------------------------------------------------------
# LEAD_RATE_LIMIT_MAX=5
# LEAD_RATE_LIMIT_WINDOW_MS=600000

# ----------------------------------------------------------------------------
# OPICIONAL: tempo máximo de espera do webhook, em milissegundos (padrão 10000).
# O Google Apps Script pode demorar alguns segundos na primeira execução.
# ----------------------------------------------------------------------------
# LEAD_WEBHOOK_TIMEOUT_MS=10000
