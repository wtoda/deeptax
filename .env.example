# ============================================================================
#  Variáveis de ambiente da Deeptax
#  Copie este arquivo para `.env.local` e preencha os valores.
# ============================================================================

# ----------------------------------------------------------------------------
# OPÇÃO 1 (recomendada para produção/serverless): envio dos leads por webhook.
# Funciona com Slack, n8n, Make, Zapier, Google Apps Script, CRM próprio...
# O lead é enviado via POST em JSON para esta URL.
# ----------------------------------------------------------------------------
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ----------------------------------------------------------------------------
# OPÇÃO 2: gravação em arquivo local (data/leads.jsonl).
# Ativa por padrão quando o webhook não está configurado. Em VPS ou container
# com disco persistente, é suficiente para não perder nenhum lead.
# Em Vercel/Netlify o sistema de arquivos é efêmero — use o webhook.
# ----------------------------------------------------------------------------

# Nome exibido nos payloads de webhook (opcional)
# NEXT_PUBLIC_SITE_NAME=Deeptax
